rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidProject(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 120)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidItem(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.stageName is string && data.stageName.size() > 0 &&
        (!('quantity' in data) || data.quantity is int) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 50));
    }

    function isValidSync(data, userId) {
      return data.userId == userId &&
        data.backupData is string && data.backupData.size() > 0 && data.backupData.size() <= 1048576;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /projects/{projectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProject(request.resource.data, userId);
      }

      match /items/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidItem(request.resource.data, userId);
      }

      match /sync/{syncId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSync(request.resource.data, userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
